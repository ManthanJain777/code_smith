# GeM Platform - Frontend Environment Variables
# For Vercel hosting, add these under Project Settings > Environment Variables

# Backend API URL (Spring Boot service)
# Example: https://gem-backend.onrender.com/api/v1
VITE_API_BASE_URL=https://your-backend-api.example.com/api/v1

# AI Service URL (FastAPI Python service)
# Example: https://gem-ai.onrender.com
VITE_AI_SERVICE_URL=https://your-ai-service.example.com

# Set to 'false' in cloud hosting so browser doesn't try probing localhost ports
VITE_PROBE_LOCAL_NODES=false
